template<typename T>
struct Fraction {
  // ABC101D
  T top, bottom;
  Fraction() : top(0), bottom(1) {} ;
  Fraction(T t, T b) : top(t), bottom(b) {
    // operator < が a/b < c/d を a*d < c*b と比べるため、分母を正にそろえる
    if (bottom < 0) top = -top, bottom = -bottom;
  } ;
  bool operator < (const Fraction& other) const {
    return top * other.bottom < other.top * bottom;
  }
};
